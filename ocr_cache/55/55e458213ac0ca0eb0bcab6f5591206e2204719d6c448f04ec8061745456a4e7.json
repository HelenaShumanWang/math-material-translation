[{"text": "圆周率的历史", "polygon": [[270.0, 335.0], [636.0, 335.0], [636.0, 392.0], [270.0, 392.0]], "confidence": 0.99627}, {"text": "轮子是古代的重要发明。由于轮", "polygon": [[953.0, 546.0], [1575.0, 546.0], [1575.0, 585.0], [953.0, 585.0]], "confidence": 0.99511}, {"text": "子的普遍应用，人们很容易想到这样", "polygon": [[864.0, 611.0], [1574.0, 612.0], [1574.0, 652.0], [864.0, 651.0]], "confidence": 0.99481}, {"text": "一个问题：一个轮子滚一圈可以滚多", "polygon": [[862.0, 675.0], [1575.0, 676.0], [1575.0, 719.0], [862.0, 718.0]], "confidence": 0.98523}, {"text": "远？显然轮子越大，滚得越远，那么", "polygon": [[860.0, 743.0], [1573.0, 743.0], [1573.0, 785.0], [860.0, 785.0]], "confidence": 0.9878}, {"text": "滚的距离与轮子的直径之间有没有关", "polygon": [[862.0, 812.0], [1574.0, 812.0], [1574.0, 851.0], [862.0, 851.0]], "confidence": 0.98914}, {"text": "系呢？", "polygon": [[859.0, 874.0], [972.0, 874.0], [972.0, 924.0], [859.0, 924.0]], "confidence": 0.99294}, {"text": "最早的解决方案是测量。当许多人多次测量之", "polygon": [[392.0, 942.0], [1292.0, 943.0], [1292.0, 985.0], [392.0, 984.0]], "confidence": 0.99711}, {"text": "后，人们发现了圆的周长总是其直径的3倍多。在我", "polygon": [[302.0, 1009.0], [1292.0, 1009.0], [1292.0, 1051.0], [302.0, 1051.0]], "confidence": 0.99616}, {"text": "国，现存有关圆周率的最早记载是2000多年前的《周", "polygon": [[306.0, 1077.0], [1292.0, 1077.0], [1292.0, 1116.0], [306.0, 1116.0]], "confidence": 0.99591}, {"text": "牌算经》。", "polygon": [[301.0, 1139.0], [490.0, 1141.0], [489.0, 1185.0], [301.0, 1183.0]], "confidence": 0.96469}, {"text": "用测量的方法计算圆周率，圆周率的精确程度取决于测量的精确", "polygon": [[392.0, 1209.0], [1575.0, 1209.0], [1575.0, 1248.0], [392.0, 1248.0]], "confidence": 0.99644}, {"text": "程度，而有许多实际困难限制了测量的精度。", "polygon": [[301.0, 1273.0], [1135.0, 1272.0], [1135.0, 1315.0], [301.0, 1316.0]], "confidence": 0.99474}, {"text": "公元前3世纪，古希腊数学", "polygon": [[389.0, 1413.0], [929.0, 1415.0], [929.0, 1461.0], [389.0, 1459.0]], "confidence": 0.99425}, {"text": "家阿基米德发现：当正多边形的", "polygon": [[303.0, 1483.0], [926.0, 1483.0], [926.0, 1523.0], [303.0, 1523.0]], "confidence": 0.98486}, {"text": "边数增加时，它的形状就越来越", "polygon": [[302.0, 1550.0], [926.0, 1550.0], [926.0, 1589.0], [302.0, 1589.0]], "confidence": 0.98929}, {"text": "接近圆。这一发现提供了计算圆", "polygon": [[300.0, 1616.0], [923.0, 1616.0], [923.0, 1656.0], [300.0, 1656.0]], "confidence": 0.99664}, {"text": "周率的新途径。阿基米德用圆内", "polygon": [[304.0, 1682.0], [926.0, 1682.0], [926.0, 1722.0], [304.0, 1722.0]], "confidence": 0.99071}, {"text": "接正多边形和圆外切正多边形从", "polygon": [[302.0, 1749.0], [925.0, 1749.0], [925.0, 1788.0], [302.0, 1788.0]], "confidence": 0.97827}, {"text": "两个方向上同时逐步逼近圆，获", "polygon": [[303.0, 1815.0], [927.0, 1815.0], [927.0, 1855.0], [303.0, 1855.0]], "confidence": 0.99082}, {"text": "在我国，首先是由魏晋", "polygon": [[1121.0, 1830.0], [1587.0, 1832.0], [1587.0, 1873.0], [1121.0, 1870.0]], "confidence": 0.99117}, {"text": "223", "polygon": [[726.0, 1875.0], [795.0, 1875.0], [795.0, 1916.0], [726.0, 1916.0]], "confidence": 0.99966}, {"text": "22", "polygon": [[878.0, 1872.0], [927.0, 1872.0], [927.0, 1924.0], [878.0, 1924.0]], "confidence": 0.99911}, {"text": "得了圆周率的值介于", "polygon": [[301.0, 1892.0], [703.0, 1892.0], [703.0, 1935.0], [301.0, 1935.0]], "confidence": 0.9971}, {"text": "和", "polygon": [[812.0, 1889.0], [864.0, 1889.0], [864.0, 1935.0], [812.0, 1935.0]], "confidence": 0.99995}, {"text": "时期杰出的数学家刘徽得出了", "polygon": [[1035.0, 1899.0], [1587.0, 1899.0], [1587.0, 1938.0], [1035.0, 1938.0]], "confidence": 0.99167}, {"text": "71", "polygon": [[735.0, 1924.0], [785.0, 1924.0], [785.0, 1964.0], [735.0, 1964.0]], "confidence": 0.99932}, {"text": "7", "polygon": [[889.0, 1921.0], [918.0, 1921.0], [918.0, 1959.0], [889.0, 1959.0]], "confidence": 0.99835}, {"text": "之间。", "polygon": [[298.0, 1945.0], [407.0, 1945.0], [407.0, 1992.0], [298.0, 1992.0]], "confidence": 0.99847}, {"text": "较精确的圆周率的值。他采用", "polygon": [[1033.0, 1965.0], [1587.0, 1965.0], [1587.0, 2005.0], [1033.0, 2005.0]], "confidence": 0.99831}, {"text": "“割圆术”一直算到圆内接正", "polygon": [[1054.0, 2031.0], [1587.0, 2031.0], [1587.0, 2071.0], [1054.0, 2071.0]], "confidence": 0.98521}, {"text": "192边形，得到圆周率的近似", "polygon": [[1033.0, 2096.0], [1589.0, 2098.0], [1589.0, 2138.0], [1033.0, 2136.0]], "confidence": 0.99792}, {"text": "值是3.14。刘徽的方法是用圆", "polygon": [[1034.0, 2162.0], [1588.0, 2162.0], [1588.0, 2205.0], [1034.0, 2205.0]], "confidence": 0.99545}, {"text": "内接正多边形从一个方向逐步", "polygon": [[1035.0, 2230.0], [1588.0, 2230.0], [1588.0, 2270.0], [1035.0, 2270.0]], "confidence": 0.98866}, {"text": "逼近圆。", "polygon": [[1029.0, 2294.0], [1178.0, 2294.0], [1178.0, 2339.0], [1029.0, 2339.0]], "confidence": 0.99442}, {"text": "12", "polygon": [[106.0, 2474.0], [176.0, 2474.0], [176.0, 2531.0], [106.0, 2531.0]], "confidence": 0.99948}]
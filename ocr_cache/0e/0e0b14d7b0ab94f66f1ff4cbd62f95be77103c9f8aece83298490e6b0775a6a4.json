[{"text": "练一练", "polygon": [[270.0, 354.0], [468.0, 357.0], [468.0, 427.0], [270.0, 425.0]], "confidence": 0.99647}, {"text": "1.估一估，说一说，大约有多少字？（30字、300字、3000字）", "polygon": [[232.0, 477.0], [1668.0, 479.0], [1668.0, 538.0], [232.0, 536.0]], "confidence": 0.97855}, {"text": "恐龙最早出现在约两亿三千五百万年前，灭亡于约六千五百万年前的白垩纪", "polygon": [[344.0, 599.0], [1643.0, 599.0], [1643.0, 635.0], [344.0, 635.0]], "confidence": 0.98771}, {"text": "生物大灭绝事件。", "polygon": [[263.0, 658.0], [556.0, 658.0], [556.0, 698.0], [263.0, 698.0]], "confidence": 0.99464}, {"text": "实际上，人类发现恐龙化石的历史由来已久。早在发现恐龙之前，欧洲人就已", "polygon": [[344.0, 719.0], [1640.0, 719.0], [1640.0, 755.0], [344.0, 755.0]], "confidence": 0.98465}, {"text": "经知道地下理藏有许多奇形怪状的巨大骨骼化石，直到发现了恐龙并与蜥蜴进行了", "polygon": [[263.0, 777.0], [1636.0, 778.0], [1636.0, 816.0], [263.0, 815.0]], "confidence": 0.99012}, {"text": "对比，科学界才初步确定这是一群类似于蜥蜴的早已灭绝的爬行动物。", "polygon": [[264.0, 840.0], [1419.0, 840.0], [1419.0, 876.0], [264.0, 876.0]], "confidence": 0.99189}, {"text": "1842年，英国古生物学家理查德·欧文提出了“恐龙”的英文名词。那个时", "polygon": [[339.0, 897.0], [1642.0, 898.0], [1642.0, 938.0], [339.0, 937.0]], "confidence": 0.98983}, {"text": "候发现的恐龙并不多。自从1989年南极洲发现恐龙后，全世界七大洲都已有了", "polygon": [[263.0, 958.0], [1635.0, 959.0], [1635.0, 996.0], [263.0, 995.0]], "confidence": 0.98264}, {"text": "恐龙的遗迹。目前，世界上被描述的恐龙至少有650~800种（古生物学上的物", "polygon": [[265.0, 1019.0], [1641.0, 1019.0], [1641.0, 1055.0], [265.0, 1055.0]], "confidence": 0.97455}, {"text": "种）。后来，中国、日本等国的学者把它译成恐龙，原因是这些国家一向有关于", "polygon": [[261.0, 1076.0], [1643.0, 1077.0], [1643.0, 1119.0], [261.0, 1118.0]], "confidence": 0.98911}, {"text": "龙的传说，认为龙是鳞虫之长，如蛇就素有小龙的别称。", "polygon": [[263.0, 1138.0], [1211.0, 1140.0], [1211.0, 1176.0], [263.0, 1174.0]], "confidence": 0.98859}, {"text": "2.比一比，估一估。", "polygon": [[232.0, 1222.0], [704.0, 1225.0], [704.0, 1275.0], [231.0, 1271.0]], "confidence": 0.92457}, {"text": "我已经爬了10厘米，还", "polygon": [[1040.0, 1305.0], [1487.0, 1301.0], [1487.0, 1344.0], [1040.0, 1348.0]], "confidence": 0.99285}, {"text": "白猫离地面大约", "polygon": [[318.0, 1332.0], [622.0, 1332.0], [622.0, 1369.0], [318.0, 1369.0]], "confidence": 0.99285}, {"text": "有", "polygon": [[1042.0, 1353.0], [1082.0, 1353.0], [1082.0, 1394.0], [1042.0, 1394.0]], "confidence": 0.99998}, {"text": "厘米就到家了。", "polygon": [[1151.0, 1358.0], [1440.0, 1358.0], [1440.0, 1394.0], [1151.0, 1394.0]], "confidence": 0.98097}, {"text": "有—厘米。", "polygon": [[311.0, 1375.0], [528.0, 1379.0], [527.0, 1427.0], [310.0, 1423.0]], "confidence": 0.95658}, {"text": "快下雨了", "polygon": [[1093.0, 1462.0], [1263.0, 1466.0], [1262.0, 1510.0], [1092.0, 1507.0]], "confidence": 0.9964}, {"text": "30厘米", "polygon": [[396.0, 1504.0], [531.0, 1506.0], [530.0, 1551.0], [395.0, 1549.0]], "confidence": 0.99669}, {"text": "3.估一估，有多少颗糖豆？", "polygon": [[234.0, 1620.0], [879.0, 1620.0], [879.0, 1669.0], [234.0, 1669.0]], "confidence": 0.96521}, {"text": "有 50颗。", "polygon": [[350.0, 1897.0], [577.0, 1897.0], [577.0, 1952.0], [350.0, 1952.0]], "confidence": 0.91969}, {"text": "大约有（_）颗。", "polygon": [[765.0, 1897.0], [1164.0, 1897.0], [1164.0, 1953.0], [765.0, 1953.0]], "confidence": 0.96889}, {"text": "大约有（）颗。", "polygon": [[1254.0, 1896.0], [1650.0, 1899.0], [1650.0, 1952.0], [1253.0, 1950.0]], "confidence": 0.97451}, {"text": "4.大约有多少枚棋子？", "polygon": [[235.0, 2000.0], [765.0, 2004.0], [765.0, 2054.0], [234.0, 2050.0]], "confidence": 0.98305}, {"text": "估一估，说一说。", "polygon": [[296.0, 2090.0], [703.0, 2090.0], [703.0, 2137.0], [296.0, 2137.0]], "confidence": 0.96666}, {"text": "圈起来的棋子", "polygon": [[533.0, 2277.0], [807.0, 2277.0], [807.0, 2317.0], [533.0, 2317.0]], "confidence": 0.99237}, {"text": "有20枚。", "polygon": [[527.0, 2325.0], [698.0, 2328.0], [697.0, 2371.0], [526.0, 2368.0]], "confidence": 0.99586}, {"text": "31", "polygon": [[1723.0, 2474.0], [1794.0, 2474.0], [1794.0, 2530.0], [1723.0, 2530.0]], "confidence": 0.99855}]
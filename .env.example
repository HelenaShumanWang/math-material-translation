# Anthropic API key used for translation, LLM review and vision OCR.
# Without a key the service falls back to the offline "mock" translator (for demos/tests only).
ANTHROPIC_API_KEY=

# Model used for translation and review (default: claude-opus-5-5)
MATHTRANS_CLAUDE_MODEL=claude-opus-5-5
# Reasoning effort for translation requests: low | medium | high | xhigh | max
MATHTRANS_CLAUDE_EFFORT=medium
# Server-side refusal fallbacks (recommended): true | false
MATHTRANS_ENABLE_FALLBACKS=true

# Translator backend: auto (claude if key present, else mock) | claude | mock
MATHTRANS_TRANSLATOR=auto
# OCR engine for text inside images: auto | rapid | claude | none
MATHTRANS_OCR_ENGINE=auto

# Where projects, uploads and outputs are stored
MATHTRANS_DATA_DIR=data
# Optional directory with extra fonts (Noto Sans SC/JP/KR etc.)
MATHTRANS_FONTS_DIR=fonts

# QA loop
MATHTRANS_MAX_QA_ROUNDS=3
MATHTRANS_REQUIRE_QA_PASS=true

# Web service limits: per-file upload size (MB), pages per document, concurrent jobs
MATHTRANS_MAX_UPLOAD_MB=100
MATHTRANS_MAX_PAGES=500
MATHTRANS_MAX_WORKERS=2
# Shared secret required on every /api/* request (Authorization: Bearer <token>).
# Set it whenever the service is reachable from other machines (--host 0.0.0.0, Docker).
MATHTRANS_API_TOKEN=
